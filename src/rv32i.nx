application rv32i;

import std.selector.*;
import std.utils.REG;
import std.arith.BARREL_SHIFTER;


/**
  * RV32I Core
  * This component implements a 5-stage pipelined RV32I core with basic branch prediction and bypassing.
  * It interfaces with external instruction and data memory and includes a simple control path for handling hazards and redirects.
  * The design includes the following pipeline stages:
  * - IF: Instruction fetch with PC generation and branch prediction.
  * - ID: Instruction decode, register read, and decode-time branch prediction.
  * - EX: ALU execution and branch resolution.
  * - MEM: Data memory access.
  * - WB: Register file writeback.
*/
component CORE : [clk, rst, instr, dmem_out] -> [
    imem_addr, dmem_addr, dmem_in, dmem_op, dmem_wr, SSD
] {
    // ===== External ports and clock/reset =====
    wire clk of clock();
    wire rst of bit(1);
    wire instr of bit(32);
    wire dmem_wr of bit(1);
    wire dmem_op of bit(3);
    wire imem_addr, dmem_addr, dmem_in, dmem_out of bit(32);

    let nop = 32'h00000013; // addi x0, x0, 0
    let rd_nonzero(rd) = OR <> [rd[i] | i in [0..5]];
    let reg(v_rst) = REG(pos_edge=true, high_rst=true, rst_value=v_rst) <> [clk#, rst#, TO];

    // ===== Pipeline register bundles (stage boundaries) =====
    bundle ifid of IF_ID_PIPE;
    bundle idex of ID_EX_PIPE;
    bundle exmem of EX_MEM_PIPE;
    bundle memwb of MEM_WB_PIPE;

    // ===== ID stage: decode, register read, and decode-time prediction =====
    auto [id_func7, id_rs2, id_rs1, id_func3, id_rd, id_op] <> [
        ifid.instr[31:25], 
        ifid.instr[24:20], 
        ifid.instr[19:15],
        ifid.instr[14:12], 
        ifid.instr[11:7], 
        ifid.instr[6:0]
    ];

    bundle id_ctl of CTL_SIGNAL_SET;
    wire id_imm of bit(32);
    id_ctl <> INSTR_DECODER <> [id_op, id_func3, id_func7[5]];
    id_imm <> IMM_SELECTOR  <> [id_ctl.ext_op, ifid.instr];

    // Decode-time branch prediction:
    // - direct JAL uses the immediate target immediately,
    // - conditional branches query the BTB and 2-bit counters,
    // - resolved EX results feed back into the predictor state.
    auto [id_redirect, id_jump_target] <> BRANCH_PREDICTOR <> {
        clk           : clk,
        rst           : rst,
        valid         : ifid.valid,
        branch        : id_ctl.branch,
        pc            : ifid.pc,
        imm           : id_imm,
        update_valid  : idex.valid,
        update_branch : idex.branch,
        update_pc     : idex.pc,
        update_taken  : ex_actual_taken,
        update_target : ex_branch_target
    };

    // ===== WB view used by ID bypass and register-file writeback =====
    auto wb_result <> MUX(1) <> [memwb.mem_to_reg, memwb.result, memwb.mem_data];
    auto exmem_fwd_ok <> AND(4) <> [
        exmem.valid,
        exmem.reg_wr,
        rd_nonzero(exmem.rd),
        NOT <> exmem.mem_to_reg
    ];
    auto memwb_fwd_ok <> AND(3) <> [memwb.valid, memwb.reg_wr, rd_nonzero(memwb.rd)];
    auto exmem_fwd_data <> exmem.result;

    auto [id_ra, id_rb, x10] <> REG_FILE (
        width=32,
        capacity=5,
        pos_edge=true,
        high_rst=true
    ) <> {
        clk       : clk,
        rst       : rst,
        rd_addr_a : id_rs1,
        rd_addr_b : id_rs2,
        wr_addr   : memwb.rd,
        wr_en     : AND <> [
            memwb.valid, 
            memwb.reg_wr, 
            rd_nonzero(memwb.rd)
        ],
        din       : wb_result
    };

    auto exmem_bypass_rs1 <> AND <> [
        exmem_fwd_ok, id_ctl.rs1_used,
        EQ <> [exmem.rd, id_rs1]
    ];
    auto wb_bypass_rs1 <> AND(4) <> [
        memwb_fwd_ok, id_ctl.rs1_used,
        EQ <> [memwb.rd, id_rs1],
        NOT <> exmem_bypass_rs1
    ];
    auto exmem_bypass_rs2 <> AND <> [
        exmem_fwd_ok, id_ctl.rs2_used,
        EQ <> [exmem.rd, id_rs2]
    ];
    auto wb_bypass_rs2 <> AND(4) <> [
        memwb_fwd_ok, id_ctl.rs2_used,
        EQ <> [memwb.rd, id_rs2],
        NOT <> exmem_bypass_rs2
    ];
    auto id_ra_eff <> MUX(1) <> [
        exmem_bypass_rs1,
        MUX(1) <> [wb_bypass_rs1, id_ra, wb_result],
        exmem_fwd_data
    ];
    auto id_rb_eff <> MUX(1) <> [
        exmem_bypass_rs2,
        MUX(1) <> [wb_bypass_rs2, id_rb, wb_result],
        exmem_fwd_data
    ];

    // ===== EX stage operand forwarding =====
    // EX/MEM forwarding only covers ALU results. Loads wait until MEM/WB so raw
    // dmem_out does not feed the redirect path combinationally.
    auto fwd_rs1_from_exmem <> AND(2) <> [exmem_fwd_ok, EQ <> [exmem.rd, idex.rs1]];
    auto fwd_rs1_from_memwb <> AND(3) <> [
        memwb_fwd_ok, EQ <> [memwb.rd, idex.rs1], NOT <> fwd_rs1_from_exmem
    ];
    auto fwd_rs2_from_exmem <> AND(2) <> [exmem_fwd_ok, EQ <> [exmem.rd, idex.rs2]];
    auto fwd_rs2_from_memwb <> AND(3) <> [
        memwb_fwd_ok, EQ <> [memwb.rd, idex.rs2], NOT <> fwd_rs2_from_exmem
    ];

    auto ex_ra_fwd <> MUX(1) <> [
        fwd_rs1_from_exmem,
        MUX(1) <> [fwd_rs1_from_memwb, idex.ra, wb_result],
        exmem_fwd_data
    ];
    auto ex_rb_fwd <> MUX(1) <> [
        fwd_rs2_from_exmem,
        MUX(1) <> [fwd_rs2_from_memwb, idex.rb, wb_result],
        exmem_fwd_data
    ];

    // A load result is only ready after MEM/WB. Stall one cycle when the next
    // instruction depends on the load currently in ID/EX.
    auto load_use_rs1 <> AND <> [
        id_ctl.rs1_used,
        rd_nonzero(idex.rd),
        EQ <> [idex.rd, id_rs1]
    ];
    auto load_use_rs2 <> AND <> [
        id_ctl.rs2_used,
        rd_nonzero(idex.rd),
        EQ <> [idex.rd, id_rs2]
    ];
    auto load_use_stall <> AND(3) <> [
        ifid.valid,
        idex.valid,
        AND <> [idex.mem_to_reg, OR <> [load_use_rs1, load_use_rs2]]
    ];
    auto id_redirect_eff <> AND <> [id_redirect, NOT <> load_use_stall];

    // ===== EX stage: branch resolution, ALU execution, redirect decision =====
    auto [ex_pc_a_src, ex_pc_b_src] <> BRANCH_COND <> [idex.branch, ex_zero, ex_less];
    auto ex_branch_target <> ADD <> [
        MUX(1) <> [ex_pc_a_src, 32'd4, idex.imm],
        MUX(1) <> [ex_pc_b_src, idex.pc, ex_ra_fwd]
    ];
    auto [ex_result, ex_zero, ex_less] <> ALU <> [
        MUX(1) <> [idex.a_src, ex_ra_fwd, idex.pc],
        MUX(2) <> [idex.b_src, ex_rb_fwd, idex.imm, 32'd4, 32'd4],
        idex.alu_ctl
    ];
    auto ex_actual_taken   <> OR  <> [ex_pc_a_src, ex_pc_b_src];
    auto ex_fallthrough_pc <> ADD <> [idex.pc, 32'd4];
    
    auto ex_correct_pc   <> MUX(1) <> [ex_actual_taken, ex_fallthrough_pc, ex_branch_target];
    auto ex_predicted_pc <> MUX(1) <> [idex.pred_taken, ex_fallthrough_pc, idex.pred_target];

    // redirect if mispredicted
    auto ex_redirect <> AND <> [
        idex.valid, 
        NE <> [ex_predicted_pc, ex_correct_pc] 
    ];

    // Flush if there's a redirect. 
    auto redirect_flush <> OR <> [id_redirect_eff, ex_redirect];
    auto ex_flush <> reg(1'b0) <> [redirect_flush];
    auto if_flush <> OR <> [redirect_flush, ex_flush];

    // ===== IF stage state =====
    wire PC of bit(32);
    // choose between sequential fetch, predicted jump, or resolved redirect
    PC <> reg(32'd0) <> MUX(1) <> [
        load_use_stall,
        MUX(1) <> [
            ex_redirect, 
            MUX(1) <> [
                id_redirect_eff, 
                ADD <> [PC, 32'd4], 
                id_jump_target
            ],
            ex_correct_pc
        ],
        PC
    ];
    imem_addr <> MUX(1) <> [rst, PC, 32'd0];

    // IF/ID register: inject NOP on redirect and hold on a load-use stall.
    ifid.valid <> reg(1'b0)  <> MUX(1) <> [
        if_flush,
        MUX(1) <> [load_use_stall, NOT <> [if_flush], ifid.valid],
        1'b0
    ];
    ifid.pc    <> reg(32'd0) <> MUX(1) <> [
        if_flush,
        MUX(1) <> [load_use_stall, SUB <> [PC, 32'd4], ifid.pc],
        32'd0
    ];
    ifid.instr <> reg(nop)   <> MUX(1) <> [
        if_flush,
        MUX(1) <> [load_use_stall, instr, ifid.instr],
        nop
    ];

    // ===== ID/EX register: either forward decoded values or insert a bubble =====
    auto idex_flush  <> OR <> [load_use_stall, OR <> [ex_redirect, ex_flush]];
    idex.valid       <> reg(1'b0)    <> MUX(1) <> [idex_flush, ifid.valid, 1'b0];
    idex.pc          <> reg(32'd0)   <> MUX(1) <> [idex_flush, ifid.pc, 32'd0];
    idex.pred_taken  <> reg(1'b0)    <> MUX(1) <> [idex_flush, id_redirect_eff, 1'b0];
    idex.pred_target <> reg(32'd0)   <> MUX(1) <> [idex_flush, id_jump_target, 32'd0];
    idex.ra          <> reg(32'd0)   <> MUX(1) <> [idex_flush, id_ra_eff, 32'd0];
    idex.rb          <> reg(32'd0)   <> MUX(1) <> [idex_flush, id_rb_eff, 32'd0];
    idex.imm         <> reg(32'd0)   <> MUX(1) <> [idex_flush, id_imm, 32'd0];
    idex.rs1         <> reg(5'd0)    <> MUX(1) <> [idex_flush, id_rs1, 5'd0];
    idex.rs2         <> reg(5'd0)    <> MUX(1) <> [idex_flush, id_rs2, 5'd0];
    idex.rd          <> reg(5'd0)    <> MUX(1) <> [idex_flush, id_rd, 5'd0];
    idex.reg_wr      <> reg(1'b0)    <> MUX(1) <> [idex_flush, id_ctl.reg_wr, 1'b0];
    idex.branch      <> reg(3'b000)  <> MUX(1) <> [idex_flush, id_ctl.branch, 3'b000];
    idex.mem_to_reg  <> reg(1'b0)    <> MUX(1) <> [idex_flush, id_ctl.mem_to_reg, 1'b0];
    idex.mem_wr      <> reg(1'b0)    <> MUX(1) <> [idex_flush, id_ctl.mem_wr, 1'b0];
    idex.mem_op      <> reg(3'b010)  <> MUX(1) <> [idex_flush, id_ctl.mem_op, 3'b010];
    idex.a_src       <> reg(1'b0)    <> MUX(1) <> [idex_flush, id_ctl.a_src, 1'b0];
    idex.b_src       <> reg(2'b00)   <> MUX(1) <> [idex_flush, id_ctl.b_src, 2'b00];
    idex.alu_ctl     <> reg(4'b0000) <> MUX(1) <> [idex_flush, id_ctl.alu_ctl, 4'b0000];

    // ===== EX/MEM register =====
    exmem.valid      <> reg(1'b0)   <> idex.valid;
    exmem.reg_wr     <> reg(1'b0)   <> idex.reg_wr;
    exmem.mem_to_reg <> reg(1'b0)   <> idex.mem_to_reg;
    exmem.mem_wr     <> reg(1'b0)   <> idex.mem_wr;
    exmem.mem_op     <> reg(3'b010) <> idex.mem_op;
    exmem.rd         <> reg(5'd0)   <> idex.rd;
    exmem.result     <> reg(32'd0)  <> ex_result;
    exmem.store_data <> reg(32'd0)  <> ex_rb_fwd;

    // ===== MEM stage: external memory request generation =====
    dmem_addr <> MUX(1) <> [exmem.valid, 32'd0, exmem.result];
    dmem_in   <> MUX(1) <> [exmem.valid, 32'd0, exmem.store_data];
    dmem_op   <> MUX(1) <> [exmem.valid, 3'b010, exmem.mem_op];
    dmem_wr   <> AND    <> [exmem.valid, exmem.mem_wr];

    // ===== MEM/WB register =====
    memwb.valid      <> reg(1'b0)  <> exmem.valid;
    memwb.reg_wr     <> reg(1'b0)  <> exmem.reg_wr;
    memwb.mem_to_reg <> reg(1'b0)  <> exmem.mem_to_reg;
    memwb.rd         <> reg(5'd0)  <> exmem.rd;
    memwb.result     <> reg(32'd0) <> exmem.result;
    memwb.mem_data   <> reg(32'd0) <> dmem_out;

    // ===== FPGA-specific I/O =====

    // Seven-segment display shows the value of x10 (a0) for observation
    wire SSD[8] of bit(7);
    for i in [0..8] {
        SSD[i] <> HEX_TO_7SEG <> x10[i*4+3 : i*4];
    }
}

/**
  * IF/ID pipeline register bundle
  * This bundle defines the signals passed from the IF stage to the ID stage.
*/
interface IF_ID_PIPE : [valid, pc, instr] {
    wire valid of bit(1);   // Marks IF/ID entry as a real instruction (not a bubble).
    wire pc    of bit(32);  // PC corresponding to `instr`.
    wire instr of bit(32);  // Raw instruction bits fetched from instruction memory.
}

/**
  * ID/EX pipeline register bundle
  * This bundle defines the signals passed from the ID stage to the EX stage, including decoded
  * operand values, control signals, and metadata needed for execution and hazard handling.
*/
interface ID_EX_PIPE : [valid, pc, pred_taken, pred_target, ra, rb, imm, rs1, rs2, rd, reg_wr, branch, mem_to_reg, mem_wr, mem_op, a_src, b_src, alu_ctl] {
    wire valid       of bit(1);  // Marks ID/EX entry as valid work for EX stage.
    wire pc          of bit(32); // Instruction PC carried into EX.
    wire pred_taken  of bit(1);  // Predictor's taken/not-taken decision captured in ID.
    wire pred_target of bit(32); // Predictor target captured in ID for EX validation.
    wire ra          of bit(32); // Decoded/bypassed source operand A value.
    wire rb          of bit(32); // Decoded/bypassed source operand B value.
    wire imm         of bit(32); // Decoded immediate value.
    wire rs1         of bit(5);  // Source register 1 index for forwarding matches.
    wire rs2         of bit(5);  // Source register 2 index for forwarding matches.
    wire rd          of bit(5);  // Destination register index.
    wire reg_wr      of bit(1);  // Enables register-file writeback when set.
    wire branch      of bit(3);  // Encoded branch/jump mode used by BRANCH_COND.
    wire mem_to_reg  of bit(1);  // Selects memory result for WB.
    wire mem_wr      of bit(1);  // Enables data-memory write in MEM stage.
    wire mem_op      of bit(3);  // Width/sign mode for memory access.
    wire a_src       of bit(1);  // Selects ALU A input: register vs PC.
    wire b_src       of bit(2);  // Selects ALU B input mux mode.
    wire alu_ctl     of bit(4);  // ALU operation selector.
}

/**
  * EX/MEM pipeline register bundle
  * This bundle defines the signals passed from the EX stage to the MEM stage, including execution results
  * and control signals needed for memory access and writeback.
*/
interface EX_MEM_PIPE : [valid, reg_wr, mem_to_reg, mem_wr, mem_op, rd, result, store_data] {
    wire valid      of bit(1);  // Marks EX/MEM entry as valid work for MEM/WB.
    wire reg_wr     of bit(1);  // Propagated register write-enable.
    wire mem_to_reg of bit(1);  // Propagated WB source selector.
    wire mem_wr     of bit(1);  // Propagated memory write-enable.
    wire mem_op     of bit(3);  // Propagated memory operation encoding.
    wire rd         of bit(5);  // Destination register index.
    wire result     of bit(32); // ALU result or computed address.
    wire store_data of bit(32); // Data to write for store instructions.
}

/**
  * MEM/WB pipeline register bundle
  * This bundle defines the signals passed from the MEM stage to the WB stage, including memory load results
  * and control signals needed for writeback.
*/
interface MEM_WB_PIPE : [valid, reg_wr, mem_to_reg, rd, result, mem_data] {
    wire valid      of bit(1);  // Marks MEM/WB entry as valid for commit.
    wire reg_wr     of bit(1);  // Final write-enable to register file.
    wire mem_to_reg of bit(1);  // Chooses between `result` and `mem_data`.
    wire rd         of bit(5);  // Destination register index for WB.
    wire result     of bit(32); // ALU-path result.
    wire mem_data   of bit(32); // Loaded memory value.
}

/**
  * Control Signal Set
  * This interface bundles all control signals generated by the instruction decoder and used throughout the pipeline.
  * It includes signals for ALU control, memory access, register writeback, and branch handling.
*/
interface CTL_SIGNAL_SET : [ext_op, reg_wr, rs1_used, rs2_used, branch, mem_to_reg, mem_wr, mem_op, a_src, b_src, alu_ctl] {
    wire ext_op     of bit(3); // Extension operation type
    wire reg_wr     of bit(1); // Indicates if the register file should be written to
    wire rs1_used   of bit(1); // Indicates if the instruction uses the rs1 field (for hazard detection)
    wire rs2_used   of bit(1); // Indicates if the instruction uses the rs2 field (for hazard detection)
    wire branch     of bit(3); // Branch operation type
    wire mem_to_reg of bit(1); // Indicates if the memory value should be written to the register file
    wire mem_wr     of bit(1); // Indicates if the memory should be written to
    wire mem_op     of bit(3); // Memory operation type
    wire a_src      of bit(1); // The source of the first operand for the ALU
    wire b_src      of bit(2); // The source of the second operand for the ALU
    wire alu_ctl    of bit(4); // The ALU control signal that determines the operation to be performed
}

/**
  * Instruction Decoder
  * This component takes the opcode and function fields from the instruction and generates the appropriate control signals.
  * It also determines the type of immediate to generate and the ALU operation to perform.
*/
component INSTR_DECODER : [op_i, func3, func7] -> [ctl] {
    wire op_i  of bit(7);
    wire func3 of bit(3);
    wire func7 of bit(1);
    bundle ctl of CTL_SIGNAL_SET;

    auto op <> op_i[6:2];
    auto opcode_valid_low <> AND(2) <> [op_i[0], op_i[1]];
    auto U_flag_0 <> AND <> [opcode_valid_low, EQ <> [op, 5'b01101]]; // lui
    auto U_flag_1 <> AND <> [opcode_valid_low, EQ <> [op, 5'b00101]]; // auipc
    auto I_flag_0 <> AND <> [opcode_valid_low, EQ <> [op, 5'b00100]]; // addi, slti, sltiu, xori, ori, andi, slli, srli, srai
    auto R_flag   <> AND <> [opcode_valid_low, EQ <> [op, 5'b01100]]; // add, sub, sll, slt, sltu, xor, srl, sra, or, and
    auto J_flag   <> AND <> [opcode_valid_low, EQ <> [op, 5'b11011]]; // jal
    auto I_flag_1 <> AND <> [opcode_valid_low, EQ <> [op, 5'b11001]]; // jalr
    auto B_flag   <> AND <> [opcode_valid_low, EQ <> [op, 5'b11000]]; // beq, bne, blt, bge, bltu, bgeu
    auto I_flag_2 <> AND <> [opcode_valid_low, EQ <> [op, 5'b00000]]; // lb, lh, lw, lbu, lhu
    auto S_flag   <> AND <> [opcode_valid_low, EQ <> [op, 5'b01000]]; // sb, sh, sw

    auto U_flag <> OR <> [U_flag_0, U_flag_1];
    auto I_flag <> OR(3) <> [I_flag_0, I_flag_1, I_flag_2];

    let case(cond, pred) = MUX(1) <> [cond, CAST <> 1'b0, pred];
    
    ctl.ext_op <> OR(5) <> [
        case(U_flag, 3'b001),
        case(I_flag, 3'b000),
        case(J_flag, 3'b100),
        case(B_flag, 3'b011),
        case(S_flag, 3'b010)
    ];
    
    ctl.reg_wr <> OR(4) <> [U_flag, I_flag, R_flag, J_flag];
    ctl.rs1_used <> OR(6) <> [I_flag_0, R_flag, I_flag_1, B_flag, I_flag_2, S_flag];
    ctl.rs2_used <> OR(3) <> [R_flag, B_flag, S_flag];

    auto de_func3 <> DECODER(3) <> func3;
    ctl.branch <> OR(3) <> [
        case(J_flag,   3'b001),
        case(I_flag_1, 3'b010),
        case(B_flag, OR(6) <> [
                case(de_func3[3'b000], 3'b100), // beq
                case(de_func3[3'b001], 3'b101), // bne
                case(de_func3[3'b100], 3'b110), // blt
                case(de_func3[3'b101], 3'b111), // bge
                case(de_func3[3'b110], 3'b110), // bltu
                case(de_func3[3'b111], 3'b111)  // bgeu
            ]
        )
    ];
    ctl.mem_to_reg <> I_flag_2;
    ctl.mem_wr <> S_flag;
    ctl.mem_op <> case(OR <> [I_flag_2, S_flag], func3);
    ctl.a_src <> OR(3) <> [U_flag_1, J_flag, I_flag_1];
    ctl.b_src <> OR(3) <> [
        case(OR(5) <> [U_flag_0, U_flag_1, I_flag_0, I_flag_2, S_flag], 2'b01),
        case(OR <> [J_flag, I_flag_1], 2'b10),
        case(OR <> [R_flag, B_flag], 2'b00)
    ];

    auto arith_ctl <> OR(8) <> [
        case(de_func3[3'b000], CONCAT <> [AND <> [func7, R_flag], 3'b000]),
        case(de_func3[3'b001], 4'b0001),
        case(de_func3[3'b010], 4'b0010),
        case(de_func3[3'b011], 4'b1010),
        case(de_func3[3'b100], 4'b0100),
        case(de_func3[3'b101], CONCAT <> [func7, 3'b101]),
        case(de_func3[3'b110], 4'b0110),
        case(de_func3[3'b111], 4'b0111)
    ];
    ctl.alu_ctl <> OR(4) <> [
        case(U_flag_0, 4'b0011),
        case(OR <> [I_flag_0, R_flag], arith_ctl),
        case(B_flag, MUX(1) <> [
            AND <> [func3[2], func3[1]],
            4'b0010, 4'b1010
        ]),
        case(OR(5) <> [U_flag_1, J_flag, I_flag_1, I_flag_2, S_flag], 4'b0000)
    ];
}

/*
  * Immediate Selector
  * This component generates the appropriate immediate value based on the instruction format.
*/
component IMM_SELECTOR: [ext_op, instr] -> [imm] {
    wire ext_op of bit(3);
    wire instr of bit(32);
    wire imm   of bit(32);

    auto immI <> CAST(32) <> instr[31:20];
    auto immU <> CONCAT <> [instr[31:12], 12'b0];
    auto immS <> CAST(32) <> CONCAT <> [instr[31:25], instr[11:7]];
    auto immB <> CAST(32) <> CONCAT <> [instr[31], instr[7], instr[30:25], instr[11:8], 1'b0];
    auto immJ <> CAST(32) <> CONCAT <> [instr[31], instr[19:12], instr[20], instr[30:21], 1'b0];

    imm <> MUX(3) <> {
        sel : ext_op,
        case[3'b000] : immI,
        case[3'b001] : immU,
        case[3'b010] : immS,
        case[3'b011] : immB,
        case[3'b100] : immJ,
        default : 32'b0
    };
}

component REG_FILE(width, capacity, pos_edge, high_rst) : 
    [clk, rst, rd_addr_a, rd_addr_b, wr_en, wr_addr, din] -> [dout_a, dout_b, data[10]] {
    wire clk of clock();
    wire rst, wr_en of bit(1);
    wire rd_addr_a, rd_addr_b, wr_addr of bit(capacity);
    wire din, dout_a, dout_b of bit(width);

    let W = 2**capacity;
    wire data[W] of bit(width);

    wire wr_mask of bit(W);
    wr_mask <> DECODER(capacity) <> wr_addr;
    for i in [0..W] {
        data[i] <> REG(pos_edge, high_rst, 0) <> [clk, rst,
            MUX(1) <> [
                AND <> [wr_mask[i], wr_en], data[i], din
            ]
        ];
    }
    dout_a <> MUX(capacity) <> [rd_addr_a] ++ [data[i] | i in [0..W]];
    dout_b <> MUX(capacity) <> [rd_addr_b] ++ [data[i] | i in [0..W]];
}
