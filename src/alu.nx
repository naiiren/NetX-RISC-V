application rv32i;

/**
  * ALU Component
  *
  * This component implements the Arithmetic Logic Unit (ALU) for the RV32I architecture. 
  * It performs various arithmetic and logical operations based on the control signals provided by the ALU controller.
  * The ALU supports addition, subtraction, logical shifts, bitwise operations, and set-less-than comparisons.
  *
  * @port a         First input operand (32 bits)
  * @port b         Second input operand (32 bits)
  * @port alu_ctl    ALU control signal (4 bits)
  *
  * @port result     ALU result output (32 bits)
  * @port zero       Zero flag output (1 bit)
  * @port less       Set-less-than flag output (1 bit)
*/
component ALU : [a, b, alu_ctl] -> [result, zero, less] {
    wire a, b       of bit(32);
    wire alu_ctl    of bit(4);
    wire zero, less of bit(1);
    wire result     of bit(32);

    auto [opcode, AL, LR, US, cin] <> ALU_CONTROLLER <> alu_ctl;
    auto [adder_result, carry, zero, overflow] <> ADDER <> [
        a, XOR <> [b, CAST(32) <> cin], cin
    ];
    less <> MUX(1) <> [
        US,
        XOR <> [carry, cin],
        XOR <> [overflow, adder_result[31]]
    ];

    // Keep the wide shifter mostly quiet when the selected ALU op is not a shift.
    auto shift_en <> EQ <> [opcode[1:0], 2'b01];
    auto shift_result <> BARREL_SHIFTER(5) <> {
        din   : MUX(1) <> [shift_en, 32'd0, a],
        shamt : MUX(1) <> [shift_en, 5'd0, b[4:0]],
        dir   : LR,
        arith : AL
    };

    result <> MUX(3) <> {
        sel : alu_ctl[2:0],
        case [3'b000] : adder_result,
        case [3'b001] : shift_result,
        case [3'b010] : UCAST(32) <> less,
        case [3'b011] : b,
        case [3'b100] : XOR <> [a, b],
        case [3'b101] : shift_result,
        case [3'b110] : OR <> [a, b],
        case [3'b111] : AND <> [a, b]
    };
}

/**
  * ALU Controller
  * This component generates the control signals for the ALU based on the ALU control input from the instruction decoder.
  * It decodes the ALU control signal to determine the operation type, shift direction, and whether to use arithmetic shifts.
  *
  * @port alu_ctl    ALU control signal (4 bits)
  *
  * @port opcode     ALU operation code (3 bits)
  * @port AL         Arithmetic/Logical shift flag
  * @port LR         Shift direction flag
  * @port US         Unsigned set-less-than flag
  * @port cin        Carry-in for addition operations
*/
component ALU_CONTROLLER : [alu_ctl] -> [opcode, AL, LR, US, cin] {
    auto opcode <> alu_ctl[2:0];
    auto     AL <> alu_ctl[3];
    auto     LR <> alu_ctl[2];
    auto     US <> NOT <> alu_ctl[3];
    auto    cin <> OR <> [alu_ctl[3], EQ <> [3'b010, opcode]];
}

/**
  * Adder Component
  *
  * This component implements a 32-bit adder using a carry-lookahead approach for efficient addition.
  * It takes two 32-bit inputs (a and b) and a carry-in (cin) to produce a 32-bit sum, a carry-out, a zero flag, and an overflow flag.
  * The zero flag indicates if the result of the addition is zero, while the overflow flag indicates if there was an overflow during the addition.
  *
  * The adder is composed of four 8-bit carry-lookahead adders (CLA) that are chained together to handle the 32-bit addition.
  *
  * @port a         First input operand (32 bits)
  * @port b         Second input operand (32 bits)
  * @port cin       Carry-in (1 bit)
  *
  * @port sum       Sum output (32 bits)
  * @port carry     Carry-out (1 bit)
  * @port zero      Zero flag (1 bit)
  * @port overflow  Overflow flag (1 bit)
*/
component ADDER : [a, b, cin] -> [sum, carry, zero, overflow] {
    wire a, b, sum                  of bit(32);
    wire cin, carry, zero, overflow of bit(1);

    let pattern(k) = 
        let msb = 4 * k + 3 in
        let lsb = 4 * k in
        [#sum[msb:lsb], TO] <> CLA(4) <> [
            a[msb:lsb]#, b[msb:lsb]#, TO
        ];

    let chain(k) =
        pattern(k) <> (
            if k == 0 then TO
            else chain(k - 1)
        );

    carry <> chain(7) <> cin;
     zero <> NOT <> OR <> [sum[i] | i in [0..32]];
    overflow <> AND <> [
        NOT <> XOR <> [a[31], b[31]],
        XOR  <> [a[31], sum[31]]
    ];
}

/**
  * Carry-Lookahead Adder Component
  *
  * This component implements a n-bit adder using a carry-lookahead approach for efficient addition.
  * It takes two n-bit inputs (a and b) and a carry-in (cin) to produce a n-bit sum and a carry-out.
  *
  * @attr n         Bit-width of the adder (max 32)
  *
  * @port a         First input operand
  * @port b         Second input operand
  * @port cin       Carry-in
  *
  * @port sum       Sum output
  * @port carry     Carry-out
*/
component CLA(n) : [a, b, cin] -> [sum, carry] {
    wire a, b, sum  of bit(n);
    wire cin, carry of bit(1);

    let P(i) = XOR <> [a[i], b[i]];
    let G(i) = AND <> [a[i], b[i]];
    let PROP(lo, hi) =
        if lo == hi then P(lo)
        else AND <> [P(hi), PROP(lo, hi - 1)];
    let GEN_TERM(k, i) =
        if k == i - 1 then G(k)
        else AND <> [G(k), PROP(k + 1, i - 1)];
    let CIN_TERM(i) = AND <> [cin, PROP(0, i - 1)];
    let C(i) =
        if i == 0 then cin
        else OR <> (
            [GEN_TERM(k, i) | k in [0..i]] ++
            [CIN_TERM(i)]
        );

    for i in [0..n] {
        sum[i] <> XOR <> [P(i), C(i)];
    }
    carry <> C(n);
}

/**
  * Barrel Shifter
  *
  * This component performs barrel shifting on a data input.
  *
  * @attr stage     Number of stages (log2(width))
  *
  * @port din       Input data
  * @port shamt     Shift amount
  * @port dir       Shift direction (0 = left, 1 = right)
  * @port arith     Arithmetic shift flag
  *
  * @port dout      Output data
  */
component BARREL_SHIFTER(stage) : [din, shamt, dir, arith] -> [dout] {
  let width = 2 ** stage;

  wire din, dout  of bit(width);
  wire shamt      of bit(stage);
  wire dir, arith of bit(1);

  auto sign_bit <> MUX(1) <> [arith, 1'b0, din[width - 1]];

  wire result[stage]  of bit(width);
  for i in [0..stage] {
      for j in [0..width] {
          let offset = 2 ** i;

          let last = (if i == 0 then din else result[i - 1]);
          let next_left  = if j >= offset        then last[j - offset] else 1'b0;
          let next_right = if j + offset < width then last[j + offset] else sign_bit;
          result[i][j] <> MUX(2) <> [
              CONCAT <> [dir, shamt[i]],
              last[j], next_left,
              last[j], next_right
          ];
      }
  }
  dout <> result[stage - 1];
}
