application rv32i;

import std.selector.*;
import std.utils.REG;

component HEX_TO_7SEG: [num] -> [code] {
    wire num  of bit(4);
    wire code of bit(7);
    code <> MUX(4) <> [
        num,
        7'b1000000, // 0
        7'b1111001, // 1
        7'b0100100, // 2
        7'b0110000, // 3
        7'b0011001, // 4
        7'b0010010, // 5
        7'b0000010, // 6
        7'b1111000, // 7
        7'b0000000, // 8
        7'b0010000, // 9
        7'b0001000, // A
        7'b0000011, // b
        7'b1000110, // C
        7'b0100001, // d
        7'b0000110, // E
        7'b0001110  // F
    ];
}

enum LCD_STATE {
    LCD_BOOT0  = 4'b0001, // Initial power-on state, wait >40ms
    LCD_BOOT1  = 4'b0010, // Second power-on state, wait >40ms
    LCD_BOOT2  = 4'b0011, // Third power-on state, wait >4.1ms
    LCD_FUNC   = 4'b0100, // Function set: 8-bit interface, 2 lines, 5x8 dots
    LCD_ON_CMD = 4'b0101, // Display on/off control: display on, cursor off, blink off
    LCD_CLEAR  = 4'b0110, // Clear display
    LCD_ENTRY  = 4'b0111, // Entry mode set: increment, no shift
    LCD_ADDR   = 4'b1100, // Set DDRAM address (for subsequent character writes)
    LCD_CHAR   = 4'b1111  // Write character to DDRAM at current address, then increment address
}

enum HD44780_CMD {
    CMD_CLEAR          = 8'h01, // Clear display and return cursor to home position
    CMD_HOME           = 8'h02, // Return cursor to home position (0,0) without clearing display
    CMD_ENTRY_MODE     = 8'h06, // Set entry mode: increment cursor, no display shift
    CMD_DISPLAY_CTRL   = 8'h0c, // Display on, cursor off, blink off
    CMD_FUNC_SET       = 8'h38, // Function set: 8-bit interface, 2 lines, 5x8 dots
    CMD_SET_DDRAM_ADDR = 8'h80, // Set DDRAM address command; OR with address (0-8'h7F) to set cursor position
    CMD_BOOT_FUNC      = 8'h30  // Basic function set used during the boot sequence to ensure the LCD is in 8-bit mode
}

/**
  * On-board LCD driver for a 16x2 HD44780-compatible character LCD. 
  * This block implements a simple FSM to initialize the LCD and then continuously update the
  * display based on a shadow text RAM that the CPU can write to via MMIO.
  * The CPU can write ASCII character codes to the text RAM, and the LCD driver will handle
  * the necessary command sequences to update the display.
  *
  * @port clk         Clock signal
  * @port rst         Reset signal
  * @port core_addr   Address bus from the CPU for MMIO access
  * @port core_wdata  Write data bus from the CPU for MMIO access
  * @port core_op     Operation type from the CPU (e.g., byte/halfword/word access)
  * @port core_we     Write enable signal from the CPU for MMIO access
  *
  * @port core_rdata  Read data bus to the CPU for MMIO access
  * @port mmio_hit    Signal indicating that the current MMIO access is targeting the LCD driver
  * @port lcd_data    8-bit data bus to the LCD (commands or character data)
  * @port lcd_blon    Backlight on signal to the LCD
  * @port lcd_en      Enable signal to the LCD (active high pulse)
  * @port lcd_on      Power on signal to the LCD
  * @port lcd_rs      Register select signal to the LCD (0 for command, 1 for data)
  * @port lcd_rw      Read/write signal to the LCD (0 for write, 1 for read)
  */
component LCD_DRIVER : [
    clk, rst, core_addr, core_wdata, core_op, core_we
] -> [
    core_rdata, mmio_hit,
    lcd_data, lcd_blon, lcd_en, lcd_on, lcd_rs, lcd_rw
] {
    wire clk of clock();
    wire rst, core_we, mmio_hit of bit(1);
    wire core_addr, core_wdata, core_rdata of bit(32);
    wire core_op of bit(3);
    wire lcd_data of bit(8);
    wire lcd_blon, lcd_en, lcd_on, lcd_rs, lcd_rw of bit(1);

    let reg(v_rst) = REG(pos_edge=true, high_rst=true, rst_value=v_rst) <> [clk#, rst#, TO];
    let write_op = OR <> [
        EQ <> [core_op, 3'b000], 
        EQ <> [core_op, 3'b001], 
        EQ <> [core_op, 3'b010]
    ];

    // MMIO decode: 8'h80000000 page for LCD status/control/text window.
    auto lcd_page <> AND <> [
        core_addr[31], 
        EQ <> [
            CONCAT <> [8'h00, core_addr[31:8]], 
            32'h00800000
        ]
    ];

    // Control signals for the LCD's HD44780-compatible interface. 
    auto lcd_status_sel <> AND <> [lcd_page, EQ <> [core_addr[7:0], 8'h00 ]];
    auto lcd_ctrl_sel   <> AND <> [lcd_page, EQ <> [core_addr[7:0], 8'h04 ]];
    auto lcd_text_sel   <> AND <> [lcd_page, EQ <> [core_addr[7:5], 3'b001]];

    mmio_hit <> OR(3) <> [lcd_status_sel, lcd_ctrl_sel, lcd_text_sel];

    // LCD controller state: boot sequence, init commands, then DDRAM scan.
    wire lcd_index of bit(5);
    wire lcd_state of LCD_STATE;
    wire lcd_phase of bit(2);
    wire lcd_wait  of bit(24);

    // CPU-visible text shadow RAM. Software writes bytes here; the LCD FSM later
    // turns them into HD44780 DDRAM transactions.
    auto lcd_clear_req    <> AND    <> [lcd_ctrl_sel, core_we, core_wdata[0]];
    auto text_ram_wr_addr <> MUX(1) <> [lcd_clear_req, core_addr[4:0],  5'd0 ];
    auto text_ram_wr_data <> MUX(1) <> [lcd_clear_req, core_wdata[7:0], 8'h20];

    // LCD text RAM: 32 bytes for a 16x2 display, initialized to spaces (8'h20).
    auto [cpu_lcd_byte, scan_lcd_byte] <> BYTE_RAM(capacity=5, rst_value=8'h20) <> {
        clk       : clk,
        rst       : rst,
        rd_addr_a : core_addr[4:0],
        rd_addr_b : lcd_index,
        wr_en     : OR <> [
            AND <> [lcd_text_sel, core_we, write_op], 
            lcd_clear_req
        ],
        wr_addr   : text_ram_wr_addr,
        din       : text_ram_wr_data
    };

    // line 0 or line 1
    auto lcd_addr_base <> MUX(1) <> [
        lcd_index[4], 
        CMD_SET_DDRAM_ADDR,
        ADD <> [CMD_SET_DDRAM_ADDR, 8'h40]
    ];

    // Convert the scan index into the proper DDRAM address for a 16x2 display.
    lcd_data <> MUX(4) <> {
        sel : lcd_state,
        case[LCD_BOOT0]  : CMD_BOOT_FUNC,
        case[LCD_BOOT1]  : CMD_BOOT_FUNC, 
        case[LCD_BOOT2]  : CMD_BOOT_FUNC,
        case[LCD_FUNC]   : CMD_FUNC_SET,
        case[LCD_ON_CMD] : CMD_DISPLAY_CTRL,
        case[LCD_CLEAR]  : CMD_CLEAR,
        case[LCD_ENTRY]  : CMD_ENTRY_MODE,
        case[LCD_ADDR]   : ADD <> [lcd_addr_base, UCAST(8) <> lcd_index[3:0]],
        case[LCD_CHAR]   : scan_lcd_byte,
        default          : CMD_FUNC_SET
    };

    // LCD transaction timing is split into setup / pulse / hold phases so the
    // generated waveform stays close to the proven wrapper-side test driver.
    auto lcd_step    <> NOR <> [lcd_wait[i] | i in [0..24]];   // Advance the timing sub-phase
    auto lcd_advance <> AND <> [EQ <> [lcd_phase, 2'd3], lcd_step]; // Advance the main FSM state

    lcd_phase <> reg(2'd0) <> MUX(1) <> [
        lcd_step, 
        lcd_phase, 
        MUX(2) <> {
            sel : lcd_phase,
            case[2'd0] : 2'd1,
            case[2'd1] : 2'd2,
            case[2'd2] : 2'd3,
            case[2'd3] : 2'd1
        }
    ];

    lcd_wait <> reg(24'd5000000) <> MUX(1) <> [
        lcd_step,
        SUB <> [lcd_wait, 24'd1],
        MUX(2) <> {
            sel : lcd_phase,
            case[2'd0] : 24'd5000,
            case[2'd1] : 24'd5000,
            case[2'd2] : 24'd5000,
            case[2'd3] : MUX(1) <> [
                NOT <> lcd_state[2], // Not in boot states
                MUX(1) <> {
                    sel     : EQ <> [lcd_state, LCD_CLEAR], 
                    case[0] : 24'd50000, 
                    case[1] : 24'd300000
                },
                MUX(4) <> {
                    sel : lcd_state,
                    case[LCD_BOOT0] : 24'd500000,
                    case[LCD_BOOT1] : 24'd500000,
                    case[LCD_BOOT2] : 24'd100000,
                    default : 24'd50000
                }
            ]
        }
    ];

    lcd_state <> reg(LCD_BOOT0) <> MUX(1) <> [
        lcd_advance, 
        lcd_state, 
        MUX(4) <> {
            sel              : lcd_state,
            case[LCD_BOOT0]  : LCD_BOOT1,
            case[LCD_BOOT1]  : LCD_BOOT2,
            case[LCD_BOOT2]  : LCD_FUNC,
            case[LCD_FUNC]   : LCD_ON_CMD,
            case[LCD_ON_CMD] : LCD_CLEAR,
            case[LCD_CLEAR]  : LCD_ENTRY,
            case[LCD_ENTRY]  : LCD_ADDR,
            case[LCD_ADDR]   : LCD_CHAR,
            case[LCD_CHAR]   : LCD_ADDR,
            default          : LCD_FUNC
        }
    ];

    lcd_index <> reg(5'd0) <> MUX(1) <> [
        AND <> [lcd_advance, EQ <> [lcd_state, LCD_CHAR]],
        lcd_index,
        MUX(1) <> [
            EQ <> [lcd_index, 5'd31],
            ADD <> [lcd_index, 5'd1], 
            5'd0
        ]
    ];

    lcd_blon <> reg(1'b0) <> lcd_blon;
    lcd_on   <> reg(1'b1) <> lcd_on;
    lcd_rw   <> reg(1'b0) <> lcd_rw;
    lcd_rs   <> EQ <> [lcd_state, LCD_CHAR];
    lcd_en   <> EQ <> [lcd_phase, 2'd2];

    // MMIO readback lets software inspect a little LCD state without needing
    // special instructions or debug hardware.
    auto mmio_word <> OR(3) <> [
        MUX(1) <> [
            lcd_status_sel, 32'd0, 
            UCAST(32) <> CONCAT <> [ 
                EQ <> [lcd_phase, 2'd3], 
                EQ <> [lcd_state, LCD_ADDR], 
                EQ <> [lcd_state, LCD_CLEAR]
            ]
        ],
        MUX(1) <> [
            lcd_ctrl_sel, 32'd0, 
            UCAST(32) <> CONCAT <> [lcd_index, lcd_clear_req]
        ],
        MUX(1) <> [
            lcd_text_sel, 32'd0, 
            UCAST(32) <> cpu_lcd_byte
        ]
    ];

    core_rdata <> MUX(3) <> {
        sel : core_op,
        case[3'b000] : CAST(32) <> mmio_word[7:0],
        case[3'b001] : CAST(32) <> mmio_word[15:0],
        case[3'b010] : mmio_word,
        case[3'b100] : CAST(32) <> mmio_word[7:0],
        case[3'b101] : CAST(32) <> mmio_word[15:0],
        default      : mmio_word
    };
}   

/**
  * PS/2 keyboard front-end. This block captures raw PS/2 scan-code bytes and
  * exposes them through a small MMIO FIFO:
  * - 8'h80000080: status {overflow, ready}
  * - 8'h80000084: data byte (read pops one entry)
  */
component PS2_KEYBOARD_DRIVER : [
    clk, rst, core_addr, core_wdata, core_op, core_we, ps2_clk, ps2_dat
] -> [
    core_rdata, mmio_hit
] {
    wire clk of clock();
    wire rst, core_we, ps2_clk, ps2_dat, mmio_hit of bit(1);
    wire core_addr, core_wdata, core_rdata of bit(32);
    wire core_op of bit(3);

    auto kbd_page <> AND <> [
        core_addr[31],
        EQ <> [
            CONCAT <> [8'h00, core_addr[31:8]],
            32'h00800000
        ]
    ];
    auto kbd_status_sel <> AND <> [kbd_page, EQ <> [core_addr[7:0], 8'h80]];
    auto kbd_data_sel   <> AND <> [kbd_page, EQ <> [core_addr[7:0], 8'h84]];

    auto kbd_pop <> AND <> [kbd_data_sel, NOT <> core_we];
    auto kbd_overflow_clr <> AND <> [kbd_status_sel, core_we, core_wdata[1]];
    auto [kbd_data_byte, kbd_ready, kbd_overflow] <> PS2_KEYBOARD <> {
        clk          : clk,
        rst          : rst,
        ps2_clk      : ps2_clk,
        ps2_dat      : ps2_dat,
        pop          : kbd_pop,
        clr_overflow : kbd_overflow_clr
    };

    mmio_hit <> OR <> [kbd_status_sel, kbd_data_sel];

    auto mmio_word <> OR(2) <> [
        MUX(1) <> [
            kbd_status_sel, 32'd0,
            UCAST(32) <> CONCAT <> [30'd0, kbd_overflow, kbd_ready]
        ],
        MUX(1) <> [
            kbd_data_sel, 32'd0,
            UCAST(32) <> kbd_data_byte
        ]
    ];

    core_rdata <> MUX(3) <> {
        sel : core_op,
        case[3'b000] : CAST(32) <> mmio_word[7:0],
        case[3'b001] : CAST(32) <> mmio_word[15:0],
        case[3'b010] : mmio_word,
        case[3'b100] : CAST(32) <> mmio_word[7:0],
        case[3'b101] : CAST(32) <> mmio_word[15:0],
        default      : mmio_word
    };
}

component BYTE_RAM(capacity, rst_value) : [clk, rst, rd_addr_a, rd_addr_b, wr_en, wr_addr, din] -> [dout_a, dout_b] {
    wire clk of clock();
    wire rst, wr_en of bit(1);
    wire rd_addr_a, rd_addr_b, wr_addr of bit(capacity);
    wire din, dout_a, dout_b of bit(8);

    let W = 2**capacity;
    wire data[W] of bit(8);
    wire wr_mask of bit(W);
    wr_mask <> DECODER(capacity) <> wr_addr;

    for i in [0..W] {
        data[i] <> REG(pos_edge=true, high_rst=true, rst_value=rst_value) <> [
            clk, rst,
            MUX(1) <> [AND <> [wr_mask[i], wr_en], data[i], din]
        ];
    }

    dout_a <> MUX(capacity) <> [rd_addr_a] ++ [data[i] | i in [0..W]];
    dout_b <> MUX(capacity) <> [rd_addr_b] ++ [data[i] | i in [0..W]];
}

/**
  * PS/2 Keyboard Receiver
  * This component samples the PS/2 clock/data pair, assembles 11-bit PS/2
  * frames, and pushes valid scan-code bytes into a small FIFO for software.
  * The receiver:
  * - synchronizes the asynchronous PS/2 pins into the system clock domain
  * - samples data on synchronized falling edges of `ps2_clk`
  * - checks the frame start/stop bits before accepting a byte
  * - buffers received bytes so MMIO polling does not lose short bursts
  *
  * @port clk           System clock
  * @port rst           Reset signal
  * @port ps2_clk       PS/2 clock input from the keyboard
  * @port ps2_dat       PS/2 data input from the keyboard
  * @port pop           Removes one byte from the receive FIFO
  * @port clr_overflow  Clears the sticky FIFO overflow flag
  *
  * @port data          Oldest buffered scan-code byte
  * @port ready         High when at least one byte is available
  * @port overflow      Sticky flag set when a received byte is dropped
  */
component PS2_KEYBOARD : [clk, rst, ps2_clk, ps2_dat, pop, clr_overflow] -> [data, ready, overflow] {
    wire clk of clock();
    wire rst, ps2_clk, ps2_dat, pop, clr_overflow of bit(1);
    wire data of bit(8);
    wire ready, overflow of bit(1);

    let reg(v_rst) = REG(pos_edge=true, high_rst=true, rst_value=v_rst) <> [clk#, rst#, TO];

    // Synchronize the external PS/2 wires into the system clock domain.
    // The keyboard drives PS2_CLK asynchronously relative to `clk`, so both
    // lines pass through two registers before the receiver looks at them.
    //
    // A PS/2 bit is sampled on each falling edge of PS2_CLK, so the receiver
    // detects that edge after synchronization and only shifts on `ps2_fall`.
    wire ps2_clk_meta, ps2_clk_sync, ps2_clk_prev of bit(1);
    wire ps2_dat_meta, ps2_dat_sync of bit(1);
    ps2_clk_meta <> reg(1'b1) <> ps2_clk;
    ps2_clk_sync <> reg(1'b1) <> ps2_clk_meta;
    ps2_clk_prev <> reg(1'b1) <> ps2_clk_sync;
    ps2_dat_meta <> reg(1'b1) <> ps2_dat;
    ps2_dat_sync <> reg(1'b1) <> ps2_dat_meta;

    auto ps2_fall <> AND <> [ps2_clk_prev, NOT <> ps2_clk_sync];

    // Collect one full PS/2 frame:
    //   start(0), 8 data bits (LSB first), parity, stop(1)
    //
    // `frame_shift` keeps the in-flight 11-bit frame. Once bit_count reaches
    // the last bit on a falling clock edge, `frame_done` goes high and the
    // receiver checks the start/stop bits before publishing `frame_byte`.
    wire bit_count of bit(4);
    wire frame_shift of bit(11);
    auto frame_shift_next <> MUX(1) <> [ps2_fall, frame_shift, CONCAT <> [ps2_dat_sync, frame_shift[10:1]]];
    auto frame_done <> AND <> [ps2_fall, EQ <> [bit_count, 4'd10]];
    auto frame_valid <> AND <> [frame_done, NOT <> frame_shift_next[0], frame_shift_next[10]];
    auto frame_byte <> frame_shift_next[8:1];

    bit_count <> reg(4'd0) <> MUX(1) <> [
        ps2_fall,
        bit_count,
        MUX(1) <> [frame_done, ADD <> [bit_count, 4'd1], 4'd0]
    ];

    frame_shift <> reg(11'd0) <> frame_shift_next;

    // Every valid frame is pushed into a tiny FIFO so software can poll the
    // keyboard MMIO registers without losing back-to-back scan-code bytes.
    auto push_byte <> frame_valid;

    auto [fifo_data, fifo_ready, fifo_full, fifo_overflow] <> BYTE_FIFO(capacity=2) <> {
        clk          : clk,
        rst          : rst,
        push         : push_byte,
        din          : frame_byte,
        pop          : pop,
        clr_overflow : clr_overflow
    };

    data <> fifo_data;
    ready <> fifo_ready;
    overflow <> fifo_overflow;
}

component BYTE_FIFO(capacity) : [clk, rst, push, din, pop, clr_overflow] -> [dout, ready, full, overflow] {
    wire clk of clock();
    wire rst, push, pop, clr_overflow of bit(1);
    wire din, dout of bit(8);
    wire ready, full, overflow of bit(1);

    let reg(v_rst) = REG(pos_edge=true, high_rst=true, rst_value=v_rst) <> [clk#, rst#, TO];
    let DEPTH = 2**capacity;

    wire rd_ptr, wr_ptr of bit(capacity);
    wire count of bit(capacity + 1);

    auto push_ok <> AND <> [push, NOT <> full];
    auto pop_ok <> AND <> [pop, ready];
    auto count_sel <> CONCAT <> [push_ok, pop_ok];

    auto [ram_rd_data, _fifo_unused] <> BYTE_RAM(capacity=capacity, rst_value=8'h00) <> {
        clk       : clk,
        rst       : rst,
        rd_addr_a : rd_ptr,
        rd_addr_b : wr_ptr,
        wr_en     : push_ok,
        wr_addr   : wr_ptr,
        din       : din
    };

    ready <> NE <> [count, UCAST(capacity + 1) <> 0];
    full <> EQ <> [count, UCAST(capacity + 1) <> DEPTH];
    rd_ptr <> reg(0) <> MUX(1) <> [
        pop_ok,
        rd_ptr,
        ADD <> [rd_ptr, UCAST(capacity) <> 1]
    ];
    wr_ptr <> reg(0) <> MUX(1) <> [
        push_ok,
        wr_ptr,
        ADD <> [wr_ptr, UCAST(capacity) <> 1]
    ];
    count <> reg(0) <> MUX(2) <> {
        sel : count_sel,
        case[2'b00] : count,
        case[2'b01] : SUB <> [count, UCAST(capacity + 1) <> 1],
        case[2'b10] : ADD <> [count, UCAST(capacity + 1) <> 1],
        case[2'b11] : count
    };
    overflow <> reg(1'b0) <> MUX(1) <> [
        clr_overflow,
        MUX(1) <> [AND <> [push, full], overflow, 1'b1],
        1'b0
    ];
    dout <> ram_rd_data;
}

enum VGA_H_STATE {
    H_VISIBLE = 2'b00, // Active video period where pixels are visible on the screen
    H_FRONT   = 2'b01, // Front porch period after the visible area, before the sync pulse
    H_SYNC    = 2'b10, // Sync pulse period where the horizontal sync signal is active
    H_BACK    = 2'b11  // Back porch period after the sync pulse, before the next visible area
}

enum VGA_V_STATE {
    V_VISIBLE = 2'b00, // Active video period where pixels are visible on the screen
    V_FRONT   = 2'b01, // Front porch period after the visible area, before the sync pulse
    V_SYNC    = 2'b10, // Sync pulse period where the vertical sync signal is active
    V_BACK    = 2'b11  // Back porch period after the sync pulse, before the next visible area
}

/**
  * VGA text-mode display for a 16:9-friendly 88'h45 character surface.
  *
  * The physical output remains standard 648'h480@60Hz for monitor compatibility
  * from a 25 MHz pixel clock, but the visible content is rendered into a
  * centered 648'h360 window. That produces the right 16:9 geometry on widescreen
  * panels while staying within the board's simple clocking setup.
  *
  * MMIO / memory map:
  * - 8'h80000100: status register
  * - 8'h00018000..8'h00018E0F: CPU-writable text window mirrored by the wrapper
  *   for VGA scanout (88'h45 bytes, top-left first)
  */
component VGA_DRIVER : [
    clk, rst, core_addr, core_wdata, core_op, core_we, scan_char
] -> [
    core_rdata, mmio_hit, scan_addr,
    vga_r, vga_g, vga_b, vga_blank_n, vga_clk, vga_hs, vga_sync_n, vga_vs
] {
    wire clk of clock();
    wire rst, core_we, mmio_hit of bit(1);
    wire core_addr, core_wdata, core_rdata of bit(32);
    wire core_op of bit(3);
    wire scan_char of bit(8);
    wire scan_addr of bit(12);
    wire vga_r, vga_g, vga_b of bit(8);
    wire vga_blank_n, vga_clk, vga_hs, vga_sync_n, vga_vs of bit(1);

    auto vga_status_sel <> AND(2) <> [
        core_addr[31],
        EQ <> [core_addr, 32'h80000100]
    ];
    mmio_hit <> vga_status_sel;

    // The VGA timing state machine runs at the pixel clock, which is half the core clock.
    wire vga_clk of bit(1);
    vga_clk <> REGISTER(pos_edge=true) <> [clk, NOT <> vga_clk];
    let pix_reg(v_rst) = REG(pos_edge=false, high_rst=true, rst_value=v_rst) <> [vga_clk#, rst#, TO];

    wire h_state of VGA_H_STATE;
    wire v_state of VGA_V_STATE;
    wire h_rem, v_rem of bit(10);
    wire x_pos, y_pos of bit(10);

    auto h_zero <> EQ <> [h_rem, 10'd0];
    auto v_zero <> EQ <> [v_rem, 10'd0];
    auto h_wrap <> AND <> [h_zero, EQ <> [h_state, H_BACK]];

    h_state <> pix_reg(H_VISIBLE) <> MUX(1) <> [
        h_zero, h_state,
        MUX(2) <> {
            sel : h_state,
            case[H_VISIBLE] : H_FRONT,
            case[H_FRONT]   : H_SYNC,
            case[H_SYNC]    : H_BACK,
            case[H_BACK]    : H_VISIBLE
        }
    ];

    h_rem <> pix_reg(10'd639) <> MUX(1) <> [
        h_zero,
        SUB <> [h_rem, 10'd1], // Count down the horizontal pixel position
        MUX(2) <> {            // Reload the horizontal pixel counter based on the current state
            sel : h_state,
            case[H_VISIBLE] : 10'd15,
            case[H_FRONT]   : 10'd95,
            case[H_SYNC]    : 10'd47,
            case[H_BACK]    : 10'd639
        }
    ];

    v_state <> pix_reg(V_VISIBLE) <> MUX(1) <> [
        AND <> [h_wrap, v_zero], v_state,
        MUX(2) <> {
            sel : v_state,
            case[V_VISIBLE] : V_FRONT,
            case[V_FRONT]   : V_SYNC,
            case[V_SYNC]    : V_BACK,
            case[V_BACK]    : V_VISIBLE
        }
    ];

    v_rem <> pix_reg(10'd479) <> MUX(1) <> [
        h_wrap, v_rem,
        MUX(1) <> [
            v_zero, 
            SUB <> [v_rem, 10'd1], // Count down the vertical pixel position
            MUX(2) <> {            // Reload the vertical pixel counter based on the current state
                sel : v_state,
                case[V_VISIBLE] : 10'd9,
                case[V_FRONT]   : 10'd1,
                case[V_SYNC]    : 10'd32,
                case[V_BACK]    : 10'd479
            }
        ]
    ];

    auto h_visible <> EQ <> [h_state, H_VISIBLE];
    auto v_visible <> EQ <> [v_state, V_VISIBLE];
    auto active_video <> AND <> [h_visible, v_visible];

    x_pos <> pix_reg(10'd0) <> MUX(1) <> [
        h_visible, 10'd0,
        MUX(1) <> [h_zero, ADD <> [x_pos, 10'd1], 10'd0]
    ];

    y_pos <> pix_reg(10'd0) <> MUX(1) <> [
        h_wrap, y_pos,
        MUX(1) <> [
            v_visible, 10'd0,
            MUX(1) <> [v_zero, ADD <> [y_pos, 10'd1], 10'd0]
        ]
    ];

    auto y_lt_top <> ULT <> [y_pos, 10'd16];
    auto y_lt_bot <> ULT <> [y_pos, 10'd464];

    auto text_band   <> AND <> [NOT <> y_lt_top, y_lt_bot];
    auto text_active <> AND <> [active_video, text_band];
    
    auto text_y <> SUB <> [y_pos, 10'd16];

    auto cell_x        <> x_pos [9:3];
    auto cell_y        <> text_y[8:4];
    auto glyph_col     <> x_pos [2:0];
    auto glyph_row_sel <> text_y[3:0];

    scan_addr <> ADD(3) <> [
        UCAST(12) <> CONCAT <> [cell_y, 6'b000000],
        UCAST(12) <> CONCAT <> [cell_y, 4'b0000],
        UCAST(12) <> cell_x
    ];

    // Align the BRAM text byte with the pixel selectors so the glyph decode does
    // not momentarily see mixed-cycle inputs, which otherwise shows up as sparkles.
    wire scan_char_q of bit(8);
    wire glyph_col_q of bit(3);
    wire glyph_row_q of bit(4);
    wire active_video_q, text_active_q of bit(1);

    scan_char_q    <> pix_reg(8'h20)   <> MUX(1) <> [text_active, 8'h20, scan_char];
    glyph_col_q    <> pix_reg(3'b000)  <> MUX(1) <> [text_active, 3'b000, glyph_col];
    glyph_row_q    <> pix_reg(4'b0000) <> MUX(1) <> [text_active, 4'b0000, glyph_row_sel];
    active_video_q <> pix_reg(1'b0)    <> active_video;
    text_active_q  <> pix_reg(1'b0)    <> text_active;

    auto glyph_row_bits <> VGA_GLYPH_ROW <> [scan_char_q, glyph_row_q];
    auto glyph_bit <> MUX(3) <> [glyph_col_q] ++ [glyph_row_bits[7 - i] | i in [0..8]];

    auto pixel_on <> AND <> [text_active_q, glyph_bit];

    vga_r       <> MUX(1) <> [pixel_on, MUX(1) <> [active_video_q, 8'h00, 8'h18], 8'hff];
    vga_g       <> MUX(1) <> [pixel_on, MUX(1) <> [active_video_q, 8'h00, 8'h18], 8'hff];
    vga_b       <> MUX(1) <> [pixel_on, MUX(1) <> [active_video_q, 8'h00, 8'h40], 8'hff];
    vga_blank_n <> active_video_q;
    vga_hs      <> NOT <> EQ <> [h_state, H_SYNC];
    vga_vs      <> NOT <> EQ <> [v_state, V_SYNC];
    vga_sync_n  <> 1'b0;

    auto mmio_word <> MUX(1) <> [vga_status_sel, 32'd0, 32'h000002d0];

    core_rdata <> MUX(3) <> {
        sel : core_op,
        case[3'b000] : CAST(32) <> mmio_word[7:0],
        case[3'b001] : CAST(32) <> mmio_word[15:0],
        case[3'b010] : mmio_word,
        case[3'b100] : CAST(32) <> mmio_word[7:0],
        case[3'b101] : CAST(32) <> mmio_word[15:0],
        default      : mmio_word
    };
}

